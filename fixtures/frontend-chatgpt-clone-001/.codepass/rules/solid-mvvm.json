      ],
      "files": [
        "**/*.cs"
      ],
      "excludeFiles": [
        "**/bin/**/*.cs",
        "**/obj/**/*.cs",
        "**/Migrations/**/*.cs",
        "**/*.g.cs",
        "**/*.Designer.cs",
        "tests/**/*.cs",
        "hidden-tests/**/*.cs"
      ]
    },
    "parameters": {
      "symbolKinds": [
        "interface"
      ],
      "capitalization": "PascalCase",
      "requiredPrefix": "I",
      "allowRegex": ""
    }
  },
